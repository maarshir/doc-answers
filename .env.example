# Скопируйте в .env и впишите ключ. Файл .env в git не попадает.
# Без ключа программа работает в демонстрационном режиме: показывает найденные куски.

# Groq: есть бесплатный уровень с ограничением частоты. Ключ на console.groq.com/keys.
# Если задан только он, ответы идут через Groq на openai/gpt-oss-120b.
GROQ_API_KEY=

# Anthropic: платный. Если заданы оба ключа, по умолчанию берётся Anthropic.
ANTHROPIC_API_KEY=

# Модель и поставщик, можно не задавать. По умолчанию claude-haiku-4-5
# или openai/gpt-oss-120b, если есть только ключ Groq. Поставщик определяется
# по имени модели (косая черта значит groq), для имён без черты на Groq
# задайте DOC_ANSWERS_PROVIDER=groq.
DOC_ANSWERS_MODEL=
DOC_ANSWERS_PROVIDER=
